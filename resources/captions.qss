QWidget#captionSidebar, QWidget#captionToolbar, QWidget#captionFormattingBar, QWidget#captionTargets,
QWidget#targetViewport, QScrollArea#targetScroll { background: palette(alternate-base); }
QSplitter::handle { background: palette(alternate-base); }
QSplitter::handle:hover { background: palette(mid); }
QPushButton, QToolButton, QComboBox, QLineEdit {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    padding: 2px 4px;
}
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background-color: palette(highlight); }
QPushButton:focus, QToolButton:focus, QComboBox:focus, QLineEdit:focus { border-color: palette(text); }
QToolButton { padding: 0; }
QToolButton#showPingStatus { border: none; }
QToolButton#showPingStatus:hover { background-color: palette(mid); }
QToolButton#showPingStatus:focus { border: 1px solid palette(text); }
QFrame#captionTargetTile { background: palette(button); border: 1px solid palette(mid); }
QFrame#captionTargetTile[active="true"] { border-color: palette(text); }
QFrame#captionTargetTile[removing="true"] { border-color: red; }
QToolButton#jumpToLatest {
    background: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 16px;
    padding: 0;
    font-family: "Segoe MDL2 Assets";
    font-size: 14px;
}
QToolButton#jumpToLatest:hover {
    background: palette(mid);
    border-color: palette(text);
}
QToolButton#jumpToLatest:pressed { background: palette(highlight); }
QCheckBox, QLabel { color: palette(window-text); }
QWidget#windowsAudioControls QProgressBar {
    background: palette(button);
    border: none;
    border-radius: 2px;
}
QWidget#windowsAudioControls QProgressBar::chunk { background: #25865f; border-radius: 2px; }
QDialog { background-color: palette(window); }
QPlainTextEdit#pingOutput { background: palette(base); color: palette(text); border: 1px solid palette(mid); }
QWidget#pingStatusPanel[warning="true"],
QWidget#pingStatusPanel[warning="true"] QPlainTextEdit#pingOutput { background: #861e2b; }
QWidget#pingStatusPanel[warning="true"] QPlainTextEdit#pingOutput { color: #ffe2e5; border-color: #ee929c; }
QComboBox QAbstractItemView, QFileDialog QAbstractItemView, QMenu {
    color: palette(text);
    background-color: palette(base);
    selection-background-color: palette(highlight);
    selection-color: palette(text);
}
