QWidget#meetingControllerPane, QWidget#pageRoot, QWidget#appLogPanel {
    background: #2B2B2B;
    color: #E4E4E4;
    font-family: "Segoe UI";
    font-size: 10pt;
}
QWidget#appLogPanel {
    border-top: 1px solid #555555;
    border-bottom: 1px solid #555555;
}
QFrame#collapseBar {
    background: #262626;
    border-top: 1px solid #4A4A4A;
}
QPushButton#collapseMeetingsButton {
    color: #E4E4E4;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "Segoe UI";
    font-size: 10pt;
    font-weight: 600;
    text-align: left;
}
QPushButton#collapseMeetingsButton:hover {
    background: #3A3A3A;
}
QPushButton#collapseMeetingsButton[collapsed="true"] {
    padding: 0;
    text-align: center;
}
QFrame#pageBar {
    background: #262626;
    border-bottom: 1px solid #4A4A4A;
}
QLabel#pageSubtitle, QLabel#mutedText {
    color: #AAAAAA;
    font-size: 9pt;
}
QPushButton#pageNavButton {
    color: #E4E4E4;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 8px 14px;
    font-size: 10pt;
    font-weight: 600;
}
QPushButton#pageNavButton:hover:enabled {
    background: #3A3A3A;
}
QPushButton#pageNavButton:checked {
    color: white;
    background: #4A4A4A;
    border: 1px solid #6A6A6A;
}
QLabel#pageTitle {
    color: #F2F2F2;
    font-size: 24pt;
    font-weight: 700;
}
QLabel#sectionTitle {
    color: #E4E4E4;
    font-size: 13pt;
    font-weight: 700;
}
QFrame#controllerRail {
    background: #262626;
    border-right: 1px solid #4A4A4A;
}
QPushButton#railMuteButton,
QPushButton#railCountButton,
QPushButton#railSoundButton,
QPushButton#railPickupButton {
    font-family: "Segoe UI";
    font-size: 9pt;
    font-weight: 600;
    padding: 0;
    border-radius: 10px;
    text-align: left;
}
QFrame#controllerRail QLabel {
    background: transparent;
    border: none;
}
QFrame#controllerRail QLabel#railIcon {
    font-family: "Segoe MDL2 Assets";
    font-size: 16px;
    font-weight: 400;
}
QFrame#controllerRail QLabel#railCaption {
    font-size: 9pt;
    font-weight: 600;
}
QFrame#controllerRail QLabel#railValue {
    font-size: 11pt;
    font-weight: 700;
}
QFrame#controllerRail QLabel#railDetail {
    color: #A6A6A6;
    font-size: 8pt;
    font-weight: 400;
}
QPushButton#railMuteButton {
    color: #E7B8B8;
    background: #3A3232;
    border: 1px solid #8A5555;
}
QPushButton#railMuteButton QLabel#railIcon,
QPushButton#railMuteButton QLabel#railCaption {
    color: #E7B8B8;
}
QPushButton#railMuteButton:hover:enabled { background: #4A3C3C; }
QPushButton#railCountButton,
QPushButton#railSoundButton {
    color: #E4E4E4;
    background: #333333;
    border: 1px solid #4E4E4E;
}
QPushButton#railCountButton QLabel#railIcon,
QPushButton#railCountButton QLabel#railCaption,
QPushButton#railCountButton QLabel#railValue,
QPushButton#railSoundButton QLabel#railIcon,
QPushButton#railSoundButton QLabel#railCaption {
    color: #E4E4E4;
}
QPushButton#railCountButton:hover:enabled,
QPushButton#railSoundButton:hover:enabled { background: #404040; }
QPushButton#railPickupButton {
    color: white;
    background: #454545;
    border: 1px solid #6A6A6A;
}
QPushButton#railPickupButton QLabel#railIcon,
QPushButton#railPickupButton QLabel#railCaption {
    color: white;
}
QPushButton#railPickupButton:hover:enabled { background: #525252; }
QPushButton#railMuteButton:disabled,
QPushButton#railSoundButton:disabled,
QPushButton#railPickupButton:disabled {
    color: #8A8A8A;
    background: #2E2E2E;
    border-color: #454545;
}
QPushButton#railMuteButton:disabled QLabel#railIcon,
QPushButton#railMuteButton:disabled QLabel#railCaption,
QPushButton#railSoundButton:disabled QLabel#railIcon,
QPushButton#railSoundButton:disabled QLabel#railCaption,
QPushButton#railPickupButton:disabled QLabel#railIcon,
QPushButton#railPickupButton:disabled QLabel#railCaption {
    color: #8A8A8A;
}
QFrame#metricCard {
    background: #333333;
    border: 1px solid #4E4E4E;
    border-radius: 11px;
}
QLabel#metricHeading {
    color: #D4D4D4;
    font-size: 9pt;
}
QLabel#metricValue {
    color: #F2F2F2;
    font-size: 15pt;
    font-weight: 700;
}
QLabel#metricDetail {
    color: #A6A6A6;
    font-size: 8pt;
}
QPushButton {
    color: #E4E4E4;
    background: #3A3A3A;
    border: 1px solid #5A5A5A;
    border-radius: 8px;
    padding: 9px 13px;
    font-weight: 600;
}
QPushButton:hover:enabled { background: #484848; }
QPushButton:disabled {
    color: #8A8A8A;
    background: #2E2E2E;
    border-color: #454545;
}
QPushButton#uiaRefreshButton {
    padding: 4px 10px;
    min-height: 28px;
    max-height: 32px;
    font-size: 9pt;
}
QPushButton#primaryButton {
    color: white;
    background: #454545;
    border: 1px solid #6A6A6A;
    font-size: 10pt;
    font-weight: 700;
}
QPushButton#primaryButton:hover:enabled { background: #525252; }
QPushButton#secondaryButton, QPushButton#soundButton, QPushButton#soundOffAllButton {
    background: #3A3A3A;
}
QWidget#meetingsContent { background: #2B2B2B; }
QPushButton#dangerButton {
    color: #E7B8B8;
    background: #3A3232;
    border: 1px solid #8A5555;
}
QLabel#countPill {
    color: #D0D0D0;
    background: #333333;
    border: 1px solid #5A5A5A;
    border-radius: 9px;
    padding: 3px 8px;
    font-weight: 700;
}
QFrame#meetingCard QPushButton#dangerButton,
QFrame#meetingCard QPushButton#secondaryButton,
QFrame#meetingCard QPushButton#soundButton,
QFrame#meetingCardActive QPushButton#dangerButton,
QFrame#meetingCardActive QPushButton#secondaryButton,
QFrame#meetingCardActive QPushButton#soundButton {
    padding: 6px 8px;
}
QFrame#meetingCard {
    background: #333333;
    border: 1px solid transparent;
    border-radius: 11px;
}
QFrame#meetingCard[hovered="true"] {
    background: #404040;
    border: 1px solid #8A8A8A;
}
QFrame#meetingCardActive {
    background: #353535;
    border: 1px solid transparent;
    border-radius: 11px;
}
QFrame#meetingCardActive[hovered="true"] {
    background: #3C3C3C;
    border: 1px solid #9A9A9A;
}
QFrame#meetingCard[dropHover="true"],
QFrame#meetingCardActive[dropHover="true"] {
    border: 2px dashed #A0A0A0;
}
QLineEdit#meetingTitle {
    color: #F2F2F2;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 1px 2px;
    font-size: 11pt;
    font-weight: 700;
    selection-background-color: #555555;
}
QLineEdit#meetingTitle:hover {
    border: 1px solid #5A5A5A;
}
QLineEdit#meetingTitle:focus {
    color: #F2F2F2;
    background: #303030;
    border: 1px solid #6A6A6A;
}
QLabel#meetingIcon {
    color: white;
    background: #4A4A4A;
    border-radius: 9px;
    font-size: 15pt;
    font-weight: 700;
}
QLabel#profileHeading {
    color: #D0D0D0;
    font-size: 10pt;
    font-weight: 700;
    padding-top: 8px;
}
QWidget#activeBadgeShell {
    background: #22C55E;
    border-radius: 9px;
}
QLabel#activeBadge {
    color: #052E1A;
    background: transparent;
    padding: 2px 0;
    font-size: 8pt;
    font-weight: 700;
}
QPushButton#activeRefreshButton {
    color: #052E1A;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
    font-size: 9pt;
    font-weight: 700;
}
QPushButton#activeRefreshButton:hover:enabled {
    color: white;
    background: #15803D;
    border-color: #166534;
}
QPushButton#activeRefreshButton:disabled {
    color: #166534;
    background: transparent;
    border-color: transparent;
}
QPushButton#cardCloseButton {
    color: #D4D4D4;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 0;
    font-size: 14pt;
    font-weight: 700;
}
QPushButton#cardCloseButton:hover:enabled {
    color: #E7B8B8;
    background: #3A3232;
    border: 1px solid #8A5555;
}
QPushButton#cardCloseButton:disabled {
    color: #8A8A8A;
    background: transparent;
    border-color: transparent;
}
QLabel#micMuted { color: #4ADE80; font-weight: 700; }
QLabel#micUnmuted { color: #FBBF24; font-weight: 700; }
QLabel#micUnknown { color: #A6A6A6; font-weight: 700; }
QLabel#soundState { font-weight: 700; }
QLabel#soundState[state="connected"] { color: #D0D0D0; }
QLabel#soundState[state="disconnected"] { color: #A6A6A6; }
QLabel#soundState[state="unknown"] { color: #FBBF24; }
QFrame#emptyMeetingsCard {
    background: #303030;
    border: 1px dashed #5A5A5A;
    border-radius: 12px;
}
QLabel#emptyIcon {
    color: #8A8A8A;
    font-size: 18pt;
}
QLabel#emptyTitle {
    color: #E4E4E4;
    font-size: 12pt;
    font-weight: 700;
}
QFrame#panel {
    background: #333333;
    border: 1px solid #4E4E4E;
    border-radius: 11px;
}
QLabel#panelHeading {
    color: #D4D4D4;
    font-size: 9pt;
    font-weight: 700;
    letter-spacing: 1px;
}
QLabel#settingsBody {
    color: #D8D8D8;
    font-size: 10pt;
}
QComboBox {
    color: #E4E4E4;
    background: #303030;
    border: 1px solid #5A5A5A;
    border-radius: 7px;
    padding: 8px;
}
QComboBox QAbstractItemView {
    color: #E4E4E4;
    background: #333333;
    selection-background-color: #555555;
}
QTabWidget::pane {
    background: #303030;
    border: 1px solid #4E4E4E;
    border-radius: 8px;
    top: -1px;
}
QTabBar::tab {
    color: #AAAAAA;
    background: #333333;
    border: 1px solid #4E4E4E;
    padding: 9px 14px;
    margin-right: 3px;
}
QTabBar::tab:selected {
    color: #F2F2F2;
    background: #404040;
    border-bottom-color: #2587F7;
}
QPlainTextEdit {
    color: #D6D6D6;
    background: #242424;
    border: none;
    selection-background-color: #555555;
    font-family: Consolas;
    font-size: 9pt;
}
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical {
    background: #303030;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #5A5A5A;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar:horizontal {
    background: #303030;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #5A5A5A;
    border-radius: 4px;
    min-width: 28px;
}
QDialog#tabImportDialog {
    background: #2B2B2B;
    color: #E4E4E4;
}
QWidget#tabImportRow {
    background: #333333;
    border: 1px solid #4E4E4E;
    border-radius: 8px;
}
QCheckBox#tabImportCheck {
    color: #F2F2F2;
    font-weight: 700;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #6A6A6A;
    border-radius: 4px;
    background: #303030;
}
QCheckBox::indicator:checked {
    background: #454545;
    border-color: #6A6A6A;
}
QPushButton#railConnectionButton,
QPushButton#railConnectionButton:hover,
QPushButton#railConnectionButton:disabled {
    background: #8A8A8A;
    border: none;
    padding: 0;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}
QPushButton#railConnectionButton[connection="ready"],
QPushButton#railConnectionButton[connection="ready"]:hover,
QPushButton#railConnectionButton[connection="ready"]:disabled {
    background: #22C55E;
    border: none;
}
