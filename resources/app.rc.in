#include <windows.h>
#include "resource.h"

// Embed the application manifest (common controls v6 + per-monitor DPI).
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@app_resources@/app.manifest"

IDI_APPICON ICON "icons/captions.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Meeting Handler - Live Caption and Meeting Controller"
            VALUE "FileVersion",     "@PROJECT_VERSION@.0"
            VALUE "CompanyName",     "Vela Innovation Technology LLC"
            VALUE "LegalCopyright",  "Copyright (C) Vela Innovation Technology LLC"
            VALUE "InternalName",    "MeetingHandler"
            VALUE "OriginalFilename","MeetingHandler.exe"
            VALUE "ProductName",     "Meeting Handler"
            VALUE "ProductVersion",  "@PROJECT_VERSION@.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
